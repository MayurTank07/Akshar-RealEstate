# API Configuration
# For Development: use the local backend port printed by Backend/npm run dev.
# Backend defaults to 5000 and may fallback to 5001 when 5000 is occupied.
# For Production: set this to your deployed backend API URL in Vercel/hosting env.
VITE_API_BASE_URL=http://127.0.0.1:5000/api

# Example production format:
# VITE_API_BASE_URL=https://akshar-realestate-backend.onrender.com/api

# Application Name
VITE_APP_NAME=Akshar Real Estate

# Google Maps Places Autocomplete
# Add this in Vercel/production env too. Leave blank to use manual location entry fallback.
VITE_GOOGLE_MAPS_API_KEY=

# Google Login / Signup
# Must match Backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# WhatsApp fallback number used if CMS Contact content has no WhatsApp number.
VITE_WHATSAPP_NUMBER=+91 98765 43210

# Environment
VITE_ENV=development
