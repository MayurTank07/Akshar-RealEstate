# API Configuration
# For Development: Use local backend or production backend from Render
# For Production: Use production backend from Render
VITE_API_BASE_URL=http://127.0.0.1:5001/api

# Alternative for local dev with production backend:
# VITE_API_BASE_URL=https://akshar-realestate-backend.onrender.com/api

# Application Name
VITE_APP_NAME=Akshar Real Estate

# Google Maps Places Autocomplete
# Add this in Vercel/production env too. Leave blank to use manual location entry fallback.
VITE_GOOGLE_MAPS_API_KEY=

# Environment
VITE_ENV=development
