{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/property-detail",
      "destination": "/properties",
      "permanent": true
    },
    {
      "source": "/property-detail/",
      "destination": "/properties",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-properties.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-locations.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-property-types.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/property/:key/",
      "destination": "/api/property-route?key=:key&slash=1"
    },
    {
      "source": "/property/:key",
      "destination": "/api/property-route?key=:key"
    },
    {
      "source": "/property",
      "destination": "/api/property-route"
    },
    {
      "source": "/properties-for-sale/:region/:locality/:intent/",
      "destination": "/api/sale-landing-route?region=:region&locality=:locality&intent=:intent&slash=1"
    },
    {
      "source": "/properties-for-sale/:region/:locality/:intent",
      "destination": "/api/sale-landing-route?region=:region&locality=:locality&intent=:intent"
    },
    {
      "source": "/properties-for-sale/:region/:locality/",
      "destination": "/api/sale-landing-route?region=:region&locality=:locality&slash=1"
    },
    {
      "source": "/properties-for-sale/:region/:locality",
      "destination": "/api/sale-landing-route?region=:region&locality=:locality"
    },
    {
      "source": "/properties-for-sale/:region/",
      "destination": "/api/sale-landing-route?region=:region&slash=1"
    },
    {
      "source": "/properties-for-sale/:region",
      "destination": "/api/sale-landing-route?region=:region"
    },
    {
      "source": "/plots-for-sale/:typeLocation/",
      "destination": "/api/sale-landing-route?prefix=plots-for-sale&typeLocation=:typeLocation&slash=1"
    },
    {
      "source": "/plots-for-sale/:typeLocation",
      "destination": "/api/sale-landing-route?prefix=plots-for-sale&typeLocation=:typeLocation"
    },
    {
      "source": "/commercial-property/:typeLocation/",
      "destination": "/api/sale-landing-route?prefix=commercial-property&typeLocation=:typeLocation&slash=1"
    },
    {
      "source": "/commercial-property/:typeLocation",
      "destination": "/api/sale-landing-route?prefix=commercial-property&typeLocation=:typeLocation"
    },
    {
      "source": "/industrial-property/:typeLocation/",
      "destination": "/api/sale-landing-route?prefix=industrial-property&typeLocation=:typeLocation&slash=1"
    },
    {
      "source": "/industrial-property/:typeLocation",
      "destination": "/api/sale-landing-route?prefix=industrial-property&typeLocation=:typeLocation"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/api/blog-route?slug=:slug&slash=1"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-route?slug=:slug"
    },
    {
      "source": "/properties/",
      "destination": "/api/page-route?path=properties"
    },
    {
      "source": "/properties",
      "destination": "/api/page-route?path=properties"
    },
    {
      "source": "/new-projects/",
      "destination": "/api/page-route?path=new-projects"
    },
    {
      "source": "/new-projects",
      "destination": "/api/page-route?path=new-projects"
    },
    {
      "source": "/about/",
      "destination": "/api/page-route?path=about"
    },
    {
      "source": "/about",
      "destination": "/api/page-route?path=about"
    },
    {
      "source": "/services/",
      "destination": "/api/page-route?path=services"
    },
    {
      "source": "/services",
      "destination": "/api/page-route?path=services"
    },
    {
      "source": "/contact/",
      "destination": "/api/page-route?path=contact"
    },
    {
      "source": "/contact",
      "destination": "/api/page-route?path=contact"
    },
    {
      "source": "/blog/",
      "destination": "/api/page-route?path=blog"
    },
    {
      "source": "/blog",
      "destination": "/api/page-route?path=blog"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/api/page-route?path=privacy-policy"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api/page-route?path=privacy-policy"
    },
    {
      "source": "/terms-of-service/",
      "destination": "/api/page-route?path=terms-of-service"
    },
    {
      "source": "/terms-of-service",
      "destination": "/api/page-route?path=terms-of-service"
    },
    {
      "source": "/login",
      "destination": "/api/page-route?path=login"
    },
    {
      "source": "/register",
      "destination": "/api/page-route?path=register"
    },
    {
      "source": "/stafflogin",
      "destination": "/api/page-route?path=stafflogin"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/api/page-route?path=admin-dashboard"
    },
    {
      "source": "/supervisor-dashboard",
      "destination": "/api/page-route?path=supervisor-dashboard"
    },
    {
      "source": "/saved",
      "destination": "/api/page-route?path=saved"
    },
    {
      "source": "/profile",
      "destination": "/api/page-route?path=profile"
    },
    {
      "source": "/admin",
      "destination": "/api/page-route?path=admin"
    },
    {
      "source": "/supervisor",
      "destination": "/api/page-route?path=supervisor"
    },
    {
      "source": "/purchase/:category/:slug",
      "destination": "/api/page-route?path=purchase"
    },
    {
      "source": "/pricing",
      "destination": "/api/page-route?path=pricing"
    },
    {
      "source": "/home",
      "destination": "/api/page-route?path=home"
    },
    {
      "source": "/enquiry",
      "destination": "/api/page-route?path=enquiry"
    },
    {
      "source": "/(.*)",
      "destination": "/api/page-route?path=$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
