{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/property/:key/",
      "destination": "/api/property-route?key=:key&slash=1"
    },
    {
      "source": "/property/:key",
      "destination": "/api/property-route?key=:key"
    },
    {
      "source": "/properties-for-sale/:region/:locality/",
      "destination": "/api/sale-landing-route?region=:region&locality=:locality&slash=1"
    },
    {
      "source": "/properties-for-sale/:region/:locality",
      "destination": "/api/sale-landing-route?region=:region&locality=:locality"
    },
    {
      "source": "/properties-for-sale/:region/",
      "destination": "/api/sale-landing-route?region=:region&slash=1"
    },
    {
      "source": "/properties-for-sale/:region",
      "destination": "/api/sale-landing-route?region=:region"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
